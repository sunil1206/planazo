# ─────────────────────────────────────────────────────────────────────────────
# Snapshare — Local Development Environment
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=snapshare-dev-secret-key-change-in-production-1234567890abcdef
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django
DJANGO_SETTINGS_MODULE=core.settings.dev

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=snapshare
DB_USER=snapshare
DB_PASSWORD=snapshare123
DB_HOST=postgres
DB_PORT=5432

# Used by both Django (django-environ) and FastAPI (psycopg2 direct)
DATABASE_URL=postgres://snapshare:snapshare123@postgres:5432/snapshare

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost:8000/accounts/google/login/callback/ as Authorised redirect URI
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── NextAuth (frontend) ───────────────────────────────────────────────────────
NEXTAUTH_SECRET=nextauth-dev-secret-change-in-production-xyz
NEXTAUTH_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Razorpay (India payments) ─────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys (use test keys for dev)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── Media / Storage ───────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media
MEDIA_URL=/media/
MAX_IMAGE_SIZE_MB=20
WATERMARK_LOGO_PATH=/app/media/watermark/logo.png

# ── Email (Resend — leave blank in dev, emails print to console) ─────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@snapshare.app

# ── Sentry (leave blank to disable — paste DSN from sentry.io to enable) ────
# Free account: https://sentry.io → New Project → Django → copy the DSN below
SENTRY_DSN=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Grafana: http://localhost:3001  (admin / snapshare123)
# Prometheus: http://localhost:9090
# Metrics endpoint (Django): http://localhost:8000/metrics
