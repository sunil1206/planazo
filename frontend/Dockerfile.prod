# ── Planazo frontend — Vite + React (production build) ─────────────────────────
# Vite bakes VITE_* env vars into the JS bundle at BUILD time (unlike Next.js,
# there is no server-side runtime to inject them into) — so they must be
# passed as build ARGs, not container environment variables.

FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_API_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

RUN npm run build

# ── Serve the static build with nginx ───────────────────────────────────────────
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
