.env

# --- Frontend (Vite + React) ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
frontend/.env*.local
# --- Frontend (stale Next.js patterns — harmless to keep, nothing matches) ---
frontend/.next/
frontend/out/

# --- Backend (FastAPI/Python) — repo-wide, not just a backend/ subfolder ---
__pycache__/
*.py[cod]
*$py.class
app/media/
app/staticfiles/
*.sqlite3
.venv/
venv/
env/

# --- OS / Tools ---
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel/
node_modules/

.next/

# TypeScript incremental build artifacts
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Production secrets — never commit
.env.production
frontend/.env.production
frontend/.env.local
