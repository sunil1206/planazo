# ─── FastAPI (app/core/config.py) ─────────────────────────────────────────────
# DEBUG must be True in local dev — see app/main.py's lifespan hook. Without
# it, a fresh local Postgres never gets its base tables created (users,
# couple_websites, etc. have no Alembic migration of their own — only
# incremental changes on top of them are tracked, starting from 0001) and
# every DB query, including login, fails. Must be False in production.
DEBUG=True

# ─── Secret key ───────────────────────────────────────────────────────────────
# Named DJANGO_SECRET_KEY for historical reasons (pre-FastAPI migration), but
# it's still live: app/core/config.py's SECRET_KEY field falls back to this
# value if SECRET_KEY itself isn't set. Used to sign JWTs and the SQLAdmin
# session cookie. Must be a real random string in production — app/core/config.py
# refuses to start with ENVIRONMENT=production and the placeholder below.
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=planazo
DB_USER=planazo
DB_PASSWORD=planazo123
DB_HOST=postgres
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ─── Google OAuth (console.cloud.google.com) ──────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Media / Storage (local) ──────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=/app/media
# Needed for local-mode uploads to render — see comment in app/core/config.py.
# Must be the URL the API server is reachable at from the browser. In
# production (STORAGE_BACKEND=s3) this is unused.
BACKEND_PUBLIC_URL=http://localhost:8000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── Email (Resend.com — free 3K/mo) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=no-reply@yourdomain.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ─── CORS (comma-separated allowed origins) ──────────────────────────────────
# 5173 is the Vite dev server default port (frontend/).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Frontend (Vite + React SPA — frontend/) ─────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Read by the frontend build/dev-server (via import.meta.env), not the backend.
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Monitoring (docker-compose.yml / docker-compose.prod.yml) ───────────────
# Required by docker-compose.prod.yml (fails startup if unset there). Dev
# compose falls back to "planazo123" if this is left unset locally.
GRAFANA_ADMIN_PASSWORD=change-me

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Production checklist ─────────────────────────────────────────────────────
# 0. Set DEBUG=False (or omit it — False is the default)
# 1. Set ENVIRONMENT=production — app/core/config.py then refuses to start if
#    SECRET_KEY/DJANGO_SECRET_KEY or DB_PASSWORD are still the dev placeholders
# 2. Set DJANGO_SECRET_KEY to a real random string (this is the app's SECRET_KEY)
# 3. Set a strong DB_PASSWORD
# 4. Set GRAFANA_ADMIN_PASSWORD to a real password (docker-compose.prod.yml
#    requires it; not documented anywhere else)
# 5. Set CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# 6. Set FRONTEND_URL=https://yourdomain.com
# 7. Set VITE_API_URL=https://yourdomain.com — this is a frontend BUILD ARG
#    (docker-compose.prod.yml's frontend.build.args), not read at runtime;
#    nginx routes /api/ to the FastAPI api container
# 8. Configure real Razorpay live keys
# 9. Configure Resend email API key
