# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_SETTINGS_MODULE=core.settings.dev

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=snapshare
DB_USER=snapshare
DB_PASSWORD=snapshare123
DB_HOST=postgres
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ─── Google OAuth (console.cloud.google.com) ──────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Media / Storage (local) ──────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── Email (Resend.com — free 3K/mo) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=no-reply@yourdomain.com

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ─── CORS (comma-separated allowed origins) ──────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXTAUTH_SECRET=your-nextauth-secret-change-this
NEXTAUTH_URL=http://localhost:3000

# ─── Docker internal (Next.js SSR → Django without going through host) ────────
# Set these in docker-compose.yml / production environment — NOT in .env
# INTERNAL_API_URL=http://django:8000
# INTERNAL_FAST_URL=http://fastapi:8001

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── Production checklist ─────────────────────────────────────────────────────
# 1. Set DJANGO_DEBUG=False
# 2. Set DJANGO_SECRET_KEY to a 50-char random string
# 3. Set DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# 4. Set CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# 5. Set FRONTEND_URL=https://yourdomain.com
# 6. Set NEXT_PUBLIC_API_URL=https://yourdomain.com  (nginx routes /api/ to Django)
# 7. Use DJANGO_SETTINGS_MODULE=core.settings.prod
# 8. Configure real Razorpay live keys
# 9. Configure Resend email API key
# 10. Use a strong DB password
